<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> &middot; TrailerFlix API</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #0b0b0f;
    }

    .tf-header {
      background: linear-gradient(180deg, #14141a 0%, #0b0b0f 100%);
      border-bottom: 1px solid #1f1f27;
    }

    .tf-logo {
      font-weight: 700;
      letter-spacing: .18em;
    }

    .tf-logo:hover {
      color: #e50914;
    }

    .tf-dot {
      width: .5rem;
      height: .5rem;
      border-radius: 50%;
      background-color: #22c55e;
      display: inline-block;
    }

    .tf-card {
      background-color: #14141a;
    }

    .tf-card-link {
      transition: transform .15s ease-in-out, border-color .15s ease-in-out;
    }

    .tf-card-link:hover {
      transform: translateY(-4px);
      border-color: #e50914 !important;
    }

    .tf-card-link:hover .tf-cta {
      color: #e50914 !important;
    }

    .tf-method {
      background-color: #e50914;
    }

    .tf-categoria {
      background-color: #23232d;
      color: #c9c9d4;
      border: 1px solid #33333f;
    }

    .tf-route {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }
  </style>
</head>

<body class="d-flex flex-column min-vh-100">

  <header class="tf-header py-3">
    <div class="container d-flex flex-wrap align-items-center justify-content-between gap-3">
      <a href="/" class="tf-logo fs-5 text-white text-decoration-none">TRAILERFLIX</a>
    </div>
  </header>
